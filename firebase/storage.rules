rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function allowed(chatId) {
      let chat = firestore.get(/databases/(default)/documents/chats/$(chatId)).data;
      return request.auth != null && request.auth.uid in chat.members && chat.status == 'accepted';
    }
    match /chats/{chatId}/{uid}/{fileId} {
      allow read: if allowed(chatId);
      allow create: if allowed(chatId) && request.auth.uid == uid
        && request.resource.size > 0 && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches('(image|audio|video)/.*')
        && request.resource.contentType != 'image/svg+xml';
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
